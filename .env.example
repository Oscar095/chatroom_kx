# En local: copiar a .env (esta en .gitignore).
# En Azure: cada clave va en Configuration > Application settings.
# PORT no se define en Azure, lo inyecta App Service.

MONGO_URI=mongodb+srv://<user>:<password>@<cluster-host>/<db>?appName=<db>
MONGO_DB=memorychat
PORT=3000

# Webhook del workflow Mensajes_Chatroom (envio manual del asesor).
# El token tiene que ser el mismo que valida el nodo Webhook en n8n.
N8N_SEND_URL=https://<subdominio>.app.n8n.cloud/webhook/chatroom-enviar
N8N_SEND_TOKEN=<token compartido con n8n>

# SQL Server (kos_apps, esquema kx) para la seccion Pedidos.
# Van desglosadas a proposito: la cadena BD_AZURE que exporta la extension de
# VS Code trae la contrasena vacia y no sirve para conectarse.
SQL_SERVER=<servidor>.database.windows.net
SQL_DATABASE=kos_apps
SQL_USER=<usuario>
SQL_PASSWORD=<clave>

# API de pedidos (Siesa Connekta). Ojo con las mayusculas de ConniKey/ConniToken:
# asi las lee pedidos.js y asi viajan como headers.
API_SIESA_PEDIDOS=https://servicios.siesacloud.com/api/connekta/v3/ejecutarconsulta?idCompania=<id>&descripcion=<consulta>
ConniKey=<key>
ConniToken=<token>

# Aviso de despacho (workflow Notificar_Despacho). Reutiliza N8N_SEND_TOKEN.
N8N_DESPACHO_URL=https://<subdominio>.app.n8n.cloud/webhook/despacho-notificar

# URL de rastreo de TCC. {guia} se sustituye por el numero de guia. Viaja como
# PARAMETRO de la plantilla y no dentro del texto aprobado, asi que cambiarla
# no obliga a volver a pasar por revision de Meta.
TCC_RASTREO_URL=https://www.tcc.com/rastreo/?{guia}

# La plantilla de despacho tiene encabezado con imagen, y Meta exige la imagen
# en CADA envio (la que se sube al crear la plantilla es solo la muestra de la
# revision). Debe ser una URL publica, PNG o JPEG, maximo 5 MB.
KOSKI_IMAGEN_URL=https://kosxpress.com/images/logos/LOGOKOS.png
